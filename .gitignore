# WorkTimer .gitignore

# =============================================================================
# C++ 构建产物
# =============================================================================

# CMake 构建目录
backend/build/
backend/build-*/
backend/cmake-build-*/
backend/out/

# C++ 编译产物
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.out
*.app
*.a
*.lib

# CMake 缓存
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt
CTestTestfile.cmake
*.cmake
!CMakeLists.txt

# 构建标记文件
.build_done

# =============================================================================
# 前端 (Vue + Vite)
# =============================================================================

# Node modules
frontend/node_modules/
node_modules/

# 前端构建产物
frontend/dist/
frontend/.vite/
frontend/.vite-ssg-temp/

# Vite 缓存
frontend/.vite/
.vite/

# 依赖锁文件（可选择保留或忽略）
# frontend/package-lock.json
# frontend/yarn.lock
# frontend/pnpm-lock.yaml

# 前端构建标记
frontend/.build_done

# =============================================================================
